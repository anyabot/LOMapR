// Cloudflare Workers config for the OpenNext deployment (see DEPLOY.md).
// Built artifacts land in .open-next/ via `opennextjs-cloudflare build`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lomapr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  // nodejs_compat: required by the OpenNext runtime.
  // global_fetch_strictly_public: the Worker proxies /models/* and /rebuilt/*
  // to lo-assets.altterisk.cc (an R2 custom domain on the SAME zone as the
  // Worker's own domain). Without this flag, same-zone subrequests are routed
  // to the zone's "origin server", which an R2 custom domain doesn't have —
  // the flag forces them onto the public path so the R2 route handles them.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // IMPORTANT: keep selective asset-first routing. Any request matching a file in
    // .open-next/assets (all _next/static, public/ files, AND every
    // prerendered page's HTML) is served directly by Cloudflare — the Worker
    // is never invoked and the request is free/unmetered. Unknown paths get
    // the static 404 page. Only intentional dynamic routes run the Worker.
    // Never set this to true / a catch-all pattern.
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/models", "/models/*",
      "/rebuilt", "/rebuilt/*",
      "/skins", "/skins/*",
      "/api", "/api/*"
    ]
  },
  // Invisible abuse protection for requests that make it past asset-first
  // routing. Counters are per client and per Cloudflare location; normal page
  // and static-asset requests never reach this binding.
  "ratelimits": [
    {
      "name": "DYNAMIC_RATE_LIMITER",
      "namespace_id": "1109202601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // Production domain. Attach after detaching lo.altterisk.cc from the old
  // Pages project (DEPLOY.md, one-time step).
  "routes": [
    { "pattern": "lo.altterisk.cc", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
