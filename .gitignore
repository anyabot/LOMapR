/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# LOCAL-ONLY: extraction toolchain, generated data, and Firebase reference
# exports are sensitive (extraction can enable cheating) and must never be
# committed. Kept strictly on local machines.
/tools/
/data/
/OLD/
# dev-only copy of data/ served statically by `npm run dev:local`
/public/local-data/
/public/local-data-rates/
# dev-only skinned-skin exports for the PixiJS test page

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
/.vscode
